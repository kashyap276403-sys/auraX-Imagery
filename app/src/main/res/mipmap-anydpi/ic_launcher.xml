<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher icon. The foreground is the AuraX glass photo-stack artwork on pure black
    (source: design/aurax-icon-art.png); the monochrome layer is its brightness as an alpha mask,
    used by Android 13+ themed icons.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
