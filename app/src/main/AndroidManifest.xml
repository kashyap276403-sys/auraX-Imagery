<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        No media permissions yet. They are added in Phase 2 together with the
        runtime request flow (READ_MEDIA_IMAGES / READ_MEDIA_VIDEO /
        READ_MEDIA_VISUAL_USER_SELECTED), so the app never asks for access it
        does not use.
    -->

    <application
        android:name=".AuraXApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AuraX">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AuraX">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
